{
  "name": "@aventine/testudo",
  "version": "0.3.0",
  "description": "The Zero-Dependency Master of Test Suites: High-Precision Financial Math, Framework-Safe Typing, and In-Browser QA Forensics",
  "main": "dist/index.js",
  "module": "dist/testudo.esm.js",
  "browser": "dist/testudo.iife.js",
  "unpkg": "dist/testudo.iife.js",
  "jsdelivr": "dist/testudo.iife.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./esm": {
      "types": "./dist/index.d.ts",
      "import": "./dist/testudo.esm.js"
    },
    "./iife": "./dist/testudo.iife.js",
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./type": {
      "types": "./dist/type.d.ts",
      "import": "./dist/type.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.js"
    },
    "./visual": {
      "types": "./dist/visual.d.ts",
      "import": "./dist/visual.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "import": "./dist/scan.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "import": "./dist/matchers.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    },
    "./calc": {
      "types": "./dist/calc.d.ts",
      "import": "./dist/calc.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./playwright": {
      "types": "./dist/adapters/playwright.d.ts",
      "import": "./dist/adapters/playwright.js"
    },
    "./standalone": {
      "types": "./dist/adapters/standalone.d.ts",
      "import": "./dist/adapters/standalone.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-bundles.js",
    "pretest": "tsc && node scripts/build-bundles.js",
    "test": "node --test tests/*.test.js",
    "test:ts": "tsc && node scripts/build-bundles.js && node --test dist/tests/*.test.js",
    "size": "tsc && node scripts/build-bundles.js && node scripts/check-size.js"
  },
  "keywords": [
    "testudo",
    "testing",
    "playwright",
    "synthetic-monitoring",
    "financial-math",
    "currency",
    "qa",
    "automation",
    "e2e",
    "zero-dependencies",
    "aventine"
  ],
  "author": "Mark Gilbert <mark@aventinelabs.com> (Aventine Labs LLC)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aventine-labs/testudo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aventine-labs/testudo.git",
    "directory": "packages/testudo-js"
  },
  "bugs": {
    "url": "https://github.com/aventine-labs/testudo/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.21.5",
    "typescript": "^7.0.2"
  }
}
